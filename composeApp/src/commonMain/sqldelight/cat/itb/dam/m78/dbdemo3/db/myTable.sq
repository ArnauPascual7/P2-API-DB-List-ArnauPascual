CREATE TABLE MyTable (
  id INTEGER PRIMARY KEY NOT NULL,
  gameid INTEGER NOT NULL,
  title TEXT NOT NULL,
  thumbnail TEXT NOT NULL,
  desc TEXT NOT NULL,
  genre TEXT NOT NULL
);
CREATE INDEX MyTable_full_name ON MyTable(title);
DELETE FROM MyTable;
INSERT INTO MyTable(gameid, title, thumbnail, desc, genre) VALUES (0, "Test", "None", "None", "None");
selectAll:
SELECT * FROM MyTable;
insert:
INSERT INTO MyTable(gameid, title, thumbnail, desc, genre) VALUES (?, ?, ?, ?, ?);
delete:
DELETE FROM MyTable WHERE id = ?;