CREATE TABLE myTable (
  id INTEGER PRIMARY KEY NOT NULL,
  title TEXT NOT NULL,
  thumbnail TEXT NOT NULL,
  desc TEXT NOT NULL,
  genre TEXT NOT NULL
);
CREATE INDEX myTable_full_name ON myTable(title);
DELETE FROM myTable;
--INSERT INTO myTable(id,title) VALUES (1, "bla");
selectAll:
SELECT * FROM myTable;
insert:
INSERT INTO myTable(title, thumbnail, desc, genre) VALUES (?, ?, ?, ?);
delete:
DELETE FROM myTable WHERE id = ?;